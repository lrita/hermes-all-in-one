#!/command/with-contenv sh
# shellcheck shell=sh
#
# 修正 hermes-workspace 相关目录的归属，确保 s6-rc 中以 hermes 身份启动
# 的 hermes-workspace / hermes-workspace-log 服务能正常读写。
#
# 背景：基础镜像 hermes-agent 的 stage2-hook 已在容器启动时把 /opt/data
# 顶层及已知子目录 chown 给 hermes，但不覆盖 /opt/app 产物目录（由构建期
# COPY 创建，归 root）、/opt/data/logs 下的 hermes-workspace 日志子目录，
# 以及 hermes-workspace 的数据目录 /opt/data/workspace。
#
# 因此本钩子在 stage2-hook 完成 UID 重映射后补齐：
#
#   * HERMES_WORKSPACE_APP_DIR        (默认 /opt/app)               ── 构建期 COPY
#                                                                    产出的应用产物
#   * /opt/data/logs/hermes-workspace                             ── 运行期日志落盘
#   * /opt/data/workspace                                         ── 工作区数据目录
#
# 处理策略：
#   - 顶层 mkdir -p 保证目录存在，避免服务首启时以 hermes 身份 mkdir 撞 EACCES
#   - chown -R hermes:hermes（这些子树由 hermes 独占管理）
#   - 失败时仅告警不 fail，与 stage2-hook 在 rootless 场景的处理一致
#
# 命名按字典序排在 04-firecrawl-setup 之后。

set -eu

: "${HERMES_WORKSPACE_APP_DIR:=/opt/app}"

# 非 root 启动的容器（例如 rootless podman / 显式 --user）已无 CAP_CHOWN，
# 直接跳过：宿主侧应自行保证目录归属正确。
if [ "$(id -u)" != 0 ]; then
    echo "[05-workspace-setup] not root — skipping chown"
    exit 0
fi

# /opt/data 下的日志与数据目录可能在 volume 首次挂载时不存在，先 mkdir -p
# 再 chown。应用产物目录由构建期 COPY 创建，这里不再 mkdir。
mkdir -p "/opt/data/logs/hermes-workspace" "/opt/data/workspace"

for dir in \
    "$HERMES_WORKSPACE_APP_DIR" \
    "/opt/data/logs/hermes-workspace" \
    "/opt/data/workspace" \
; do
    [ -e "$dir" ] || continue
    chown -R hermes:hermes "$dir" 2>/dev/null || \
        echo "[05-workspace-setup] Warning: chown $dir failed (rootless container?) — continuing"
done
