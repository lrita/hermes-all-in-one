+    async def delete(self, account_id: str, user_id: str, expected_token: str) -> bool:
+        """Evict a stale ``context_token`` iff the cache still holds ``expected_token``, then persist. Compare-and-set
+        keeps a concurrent inbound message's fresh token from being clobbered by an outbound send's staleness signal."""
+        key = self._key(account_id, user_id)
+        if self._cache.get(key) != expected_token:
+            return False
+        self._cache.pop(key, None)
+        async with self._persist_lock:
+            prefix = f"{account_id}:"
+            payload = {k[len(prefix):]: v for k, v in self._cache.items() if k.startswith(prefix)}
+            await asyncio.to_thread(self._persist, account_id, payload)
+        return True
